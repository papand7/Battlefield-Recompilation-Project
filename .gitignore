# Only the two recompilation projects (and this repo's own files) are tracked.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/docs/
!/bf1943-recomp/
!/bfbc1-recomp/

# Copyrighted game data and anything derived from it never enters the repo.
original/
generated/
*.xex
*.fbrb
*.pipelinecache
*.pipelinecache.tmp

# Local / build output
build/
out/
.vs/
frames/
research/
userdata*/
server_data*/
shader_cache/
# NVIDIA's DLSS SDK: its licence keeps it out of an open repo (tools/fetch_dlss.py)
bf1943-recomp/thirdparty/dlss/
# The bots' advisor: llama.cpp and the model (tools/setup_bot_llm.py)
llm/
*.log
*.wav
*.out
node_modules/
**/launcher/dist/
**/server/arcadia360/bin/
**/server/arcadia360/obj/
.git-upstream/
__pycache__/
# Bad Company's nav notes written while it plays (where routes failed): play data
bfbc1-recomp/nav/
