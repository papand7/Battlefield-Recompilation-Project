{
  "name": "bf1943-launcher",
  "productName": "BF1943 Launcher",
  "version": "0.1.1",
  "description": "Launcher for the Battlefield 1943 PC recompilation",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-packager . BF1943Launcher --platform=win32 --arch=x64 --out=dist --overwrite --asar --ignore=^/dist",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "electron": "^33.2.1",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "build": {
    "appId": "io.github.papand7.battlefield.launcher",
    "productName": "BF1943 Launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "setup.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../build/release_sources",
        "to": "source"
      }
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "BattlefieldLauncher-${version}.exe"
    }
  }
}
